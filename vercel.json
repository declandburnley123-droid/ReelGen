{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "legal.html", "use": "@vercel/static" },
    { "src": "generate.js", "use": "@vercel/node" },
    { "src": "checkout.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/generate", "dest": "/generate.js" },
    { "src": "/api/checkout", "dest": "/checkout.js" },
    { "src": "/legal.html", "dest": "/legal.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
